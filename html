<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Sonic Fusion - DJ Mixer Pro</title>
  <style>
    :root {
      --bg-color: radial-gradient(circle at center, #111 0%, #000 100%);
      --neon-cyan: #0ff;
      --neon-green: #0f0;
      --neon-pink: #f0f;
      --neon-red: #ff3333;
    }

    body {
      margin: 0;
      background: var(--bg-color);
      color: #fff;
      font-family: 'Segoe UI', sans-serif;
      text-align: center;
      padding: 20px;
      padding-bottom: 90px;
    }

    /* Tela de Capa Interativa */
    #coverScreen {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      background: linear-gradient(rgba(0,0,0,0.85), rgba(0,0,0,0.95)), url('./assets/cover-bg.jpg') no-repeat center center/cover;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      z-index: 1000;
      transition: opacity 0.5s ease;
    }

    #coverScreen.fallback-bg {
      background: linear-gradient(rgba(0,0,0,0.85), rgba(0,0,0,0.95)), url('https://images.unsplash.com/photo-1598488035139-bdbb2231ce04?q=80&w=1200&auto=format&fit=crop') no-repeat center center/cover;
    }

    .cover-card {
      background: rgba(20, 20, 20, 0.85);
      border: 2px solid var(--neon-cyan);
      box-shadow: 0 0 30px rgba(0, 255, 255, 0.4);
      border-radius: 20px;
      padding: 40px;
      max-width: 500px;
      width: 90%;
      backdrop-filter: blur(10px);
    }

    .cover-card h1 {
      color: var(--neon-cyan);
      text-shadow: 0 0 15px var(--neon-cyan);
      font-size: 2.2rem;
      margin-bottom: 5px;
      letter-spacing: 2px;
    }

    .cover-card p {
      color: #aaa;
      font-size: 1rem;
      margin-bottom: 30px;
    }

    .cover-buttons {
      display: flex;
      justify-content: space-around;
      gap: 15px;
      flex-wrap: wrap;
    }

    .neon-btn {
      background: transparent;
      border: 2px solid;
      padding: 15px 25px;
      border-radius: 50px;
      font-weight: bold;
      font-size: 1rem;
      cursor: pointer;
      transition: all 0.3s ease;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
      flex: 1;
      min-width: 110px;
    }

    .btn-preview {
      border-color: var(--neon-green);
      color: var(--neon-green);
      box-shadow: 0 0 10px rgba(0, 255, 0, 0.2);
    }
    .btn-preview:hover {
      background: var(--neon-green);
      color: #000;
      box-shadow: 0 0 20px var(--neon-green);
      transform: scale(1.05);
    }

    .btn-start {
      border-color: var(--neon-red);
      color: var(--neon-red);
      box-shadow: 0 0 10px rgba(255, 51, 51, 0.2);
    }
    .btn-start:hover {
      background: var(--neon-red);
      color: #fff;
      box-shadow: 0 0 20px var(--neon-red);
      transform: scale(1.05);
    }

    .btn-record {
      border-color: var(--neon-pink);
      color: var(--neon-pink);
      box-shadow: 0 0 10px rgba(255, 0, 255, 0.2);
    }
    .btn-record:hover {
      background: var(--neon-pink);
      color: #fff;
      box-shadow: 0 0 20px var(--neon-pink);
      transform: scale(1.05);
    }

    /* Aplicação Principal */
    #appContent {
      display: none;
    }

    .header-section {
      margin-bottom: 30px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 15px;
    }

    h1.app-title {
      color: var(--neon-cyan);
      text-shadow: 0 0 10px var(--neon-cyan);
      margin: 0;
    }

    .container {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 20px;
      max-width: 1000px;
      margin: auto;
    }

    .deck {
      background: rgba(30, 30, 30, 0.8);
      border-radius: 12px;
      padding: 20px;
      box-shadow: 0 0 20px rgba(0, 255, 255, 0.2);
      backdrop-filter: blur(6px);
    }

    h2 {
      color: var(--neon-green);
      margin-bottom: 10px;
    }

    input[type="range"], select {
      width: 100%;
      margin: 5px 0;
    }

    button.control-btn {
      background: linear-gradient(45deg, var(--neon-green), var(--neon-cyan));
      border: none;
      padding: 10px 16px;
      border-radius: 8px;
      color: #000;
      font-weight: bold;
      margin: 5px;
      cursor: pointer;
      transition: transform 0.2s ease;
    }
    button.control-btn:hover { transform: scale(1.05); }
    button.control-btn.active-fx {
      background: linear-gradient(45deg, var(--neon-pink), var(--neon-red));
      color: #fff;
      box-shadow: 0 0 12px var(--neon-pink);
    }

    .waveform, canvas {
      margin-top: 10px;
      border-radius: 6px;
      background: #222;
      width: 100%;
    }
    .waveform { height: 80px; }
    canvas { height: 100px; }
    .time { font-size: 14px; color: #aaa; margin-top: 5px; }
    .crossfader { margin-top: 40px; }

    #downloadLink {
      display: none;
      margin-top: 10px;
      color: var(--neon-cyan);
      text-decoration: underline;
    }

    .footer-note {
      margin-top: 30px;
      font-size: 13px;
      color: #888;
    }
    .footer-note button {
      background: none;
      border: none;
      color: var(--neon-cyan);
      text-decoration: underline;
      cursor: pointer;
      font-size: 13px;
      padding: 0;
    }

    /* Modal de Política de Privacidade */
    #privacyModal {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.88);
      z-index: 2000;
      justify-content: center;
      align-items: center;
      padding: 20px;
    }
    .privacy-box {
      background: #161616;
      border: 1px solid var(--neon-cyan);
      box-shadow: 0 0 25px rgba(0, 255, 255, 0.3);
      border-radius: 14px;
      max-width: 600px;
      width: 100%;
      max-height: 80vh;
      overflow-y: auto;
      padding: 24px;
      text-align: left;
      color: #ddd;
      line-height: 1.5;
    }
    .privacy-box h3 {
      color: var(--neon-cyan);
      margin-top: 0;
    }
    .privacy-box h4 {
      color: var(--neon-green);
      margin-bottom: 4px;
    }
    .privacy-actions {
      margin-top: 20px;
      text-align: right;
    }
  </style>
</head>
<body>

  <!-- Capa Estilo Mixagem -->
  <div id="coverScreen">
    <div class="cover-card">
      <h1>SONIC FUSION</h1>
      <p>THE ART OF MIXING - LIVE SESSIONS</p>
      <div class="cover-buttons">
        <button class="neon-btn btn-preview" onclick="launchApp('preview')">
          <span>🎧</span> Pré-escuta
        </button>
        <button class="neon-btn btn-start" onclick="launchApp('start')">
          <span>▶️</span> Iniciar Mixagem
        </button>
        <button class="neon-btn btn-record" onclick="launchApp('record')">
          <span>🔴</span> Gravar
        </button>
      </div>
    </div>
  </div>

  <!-- Interface do Aplicativo de Mixagem -->
  <div id="appContent">
    <div class="header-section">
      <h1 class="app-title">🎧 Sonic Fusion - DJ Mixer Studio</h1>
    </div>

    <div class="container">
      <!-- Deck A -->
      <div class="deck" id="deckA">
        <h2>Deck A</h2>
        <input type="file" accept="audio/*" onchange="loadTrack(this, 'A')">
        <br>
        <button class="control-btn" onclick="play('A')">▶️ Play</button>
        <button class="control-btn" onclick="pause('A')">⏸️ Pause</button>
        <button class="control-btn" onclick="setCue('A')">🎯 Cue</button>
        <button class="control-btn" onclick="goToCue('A')">⏪ Go Cue</button>
        <button class="control-btn" onclick="startLoop('A')">🔁 Loop</button>
        <button class="control-btn" onclick="stopLoop('A')">⏹️ Stop</button>

        <label>Volume</label>
        <input type="range" min="0" max="1" step="0.01" value="1" oninput="setVolume(this.value, 'A')">
        <label>Pitch</label>
        <input type="range" min="0.5" max="2" step="0.01" value="1" oninput="setPitch(this.value, 'A')">
        <label>Graves</label>
        <input type="range" min="-30" max="30" value="0" step="1" oninput="setEQ('A','low',this.value)">
        <label>Médios</label>
        <input type="range" min="-30" max="30" value="0" step="1" oninput="setEQ('A','mid',this.value)">
        <label>Agudos</label>
        <input type="range" min="-30" max="30" value="0" step="1" oninput="setEQ('A','high',this.value)">

        <div id="waveA" class="waveform"></div>
        <canvas id="spectrumA"></canvas>
        <div id="timeA" class="time">00:00 / 00:00</div>
      </div>

      <!-- Deck B -->
      <div class="deck" id="deckB">
        <h2>Deck B</h2>
        <input type="file" accept="audio/*" onchange="loadTrack(this, 'B')">
        <br>
        <button class="control-btn" onclick="play('B')">▶️ Play</button>
        <button class="control-btn" onclick="pause('B')">⏸️ Pause</button>
        <button class="control-btn" onclick="setCue('B')">🎯 Cue</button>
        <button class="control-btn" onclick="goToCue('B')">⏪ Go Cue</button>
        <button class="control-btn" onclick="startLoop('B')">🔁 Loop</button>
        <button class="control-btn" onclick="stopLoop('B')">⏹️ Stop</button>

        <label>Volume</label>
        <input type="range" min="0" max="1" step="0.01" value="1" oninput="setVolume(this.value, 'B')">
        <label>Pitch</label>
        <input type="range" min="0.5" max="2" step="0.01" value="1" oninput="setPitch(this.value, 'B')">
        <label>Graves</label>
        <input type="range" min="-30" max="30" value="0" step="1" oninput="setEQ('B','low',this.value)">
        <label>Médios</label>
        <input type="range" min="-30" max="30" value="0" step="1" oninput="setEQ('B','mid',this.value)">
        <label>Agudos</label>
        <input type="range" min="-30" max="30" value="0" step="1" oninput="setEQ('B','high',this.value)">

        <div id="waveB" class="waveform"></div>
        <canvas id="spectrumB"></canvas>
        <div id="timeB" class="time">00:00 / 00:00</div>
      </div>
    </div>

    <!-- Crossfader -->
    <div class="deck crossfader">
      <h2>🎚️ Crossfader</h2>
      <input type="range" id="xfader" min="0" max="1" step="0.01" value="0.5" oninput="crossfade(this.value)">
      <label>Curva:</label>
      <select id="curve" onchange="crossfade(document.getElementById('xfader').value)">
        <option value="linear">Linear</option>
        <option value="exponential">Exponencial</option>
        <option value="log">Logarítmica</option>
        <option value="s">Curva em S</option>
      </select>
    </div>

    <!-- Painel de Efeitos -->
    <div class="deck">
      <h2>🎧 Painel de Efeitos (DSP FX)</h2>
      <label>Deck Alvo:</label>
      <select id="fxDeck" onchange="syncFxButtons()">
        <option value="A">Deck A</option>
        <option value="B">Deck B</option>
      </select>
      <button id="btnSweep" class="control-btn" onclick="sweepFilter(getFXDeck())">🌊 Sweep Filter</button>
      <button id="btnReverb" class="control-btn" onclick="toggleReverb(getFXDeck(), this)">🌫️ Reverb: OFF</button>
      <button id="btnDelay" class="control-btn" onclick="toggleDelay(getFXDeck(), this)">⏱️ Delay: OFF</button>
    </div>

    <!-- Gravação -->
    <div class="deck">
      <h2>🎙️ Gravação da Sessão</h2>
      <button class="control-btn" onclick="startRecording()">🔴 Iniciar Gravação</button>
      <button class="control-btn" onclick="stopRecording()">⏹️ Parar Gravação</button>
      <br>
      <a id="downloadLink"></a>
    </div>

    <!-- Rodapé com Política de Privacidade funcional -->
    <div class="footer-note">
      Sonic Fusion DJ Mixer • <button type="button" onclick="openPrivacyPolicy()">Política de Privacidade</button>
    </div>
  </div>

  <!-- Modal Interno de Política de Privacidade -->
  <div id="privacyModal" role="dialog" aria-modal="true" aria-labelledby="privacyTitle" onclick="if(event.target===this) closePrivacyPolicy()">
    <div class="privacy-box">
      <h3 id="privacyTitle">Política de Privacidade — Sonic Fusion</h3>
      <p><strong>Última atualização:</strong> Novembro de 2026</p>

      <h4>1. Processamento Local de Áudio</h4>
      <p>O aplicativo <strong>Sonic Fusion - DJ Mixer Pro</strong> processa seus arquivos de áudio e gravações localmente no seu dispositivo. Nenhuma faixa musical ou gravação é enviada para servidores externos.</p>

      <h4>2. Publicidade (Google AdMob)</h4>
      <p>Este aplicativo utiliza o serviço <strong>Google AdMob</strong> para exibir anúncios. O Google e seus parceiros podem coletar e utilizar identificadores de publicidade do dispositivo (como o ID de publicidade do Android), endereço IP e dados de interação para exibir anúncios relevantes e medir o desempenho das campanhas.</p>

      <h4>3. Seus Direitos (LGPD)</h4>
      <p>Você pode redefinir ou desativar a personalização de anúncios a qualquer momento nas configurações de privacidade do seu dispositivo Android (<em>Configurações &gt; Google &gt; Anúncios</em>).</p>

      <h4>4. Contato</h4>
      <p>Em caso de dúvidas sobre esta Política de Privacidade, entre em contato pelo e-mail: <strong id="privacyEmail">contato@seudominio.com</strong></p>

      <div class="privacy-actions">
        <a id="externalPrivacyLink" href="#" target="_blank" rel="noopener" style="display:none; margin-right: 12px; color: var(--neon-cyan);">Abrir no navegador</a>
        <button class="control-btn" onclick="closePrivacyPolicy()">Fechar</button>
      </div>
    </div>
  </div>

  <script>
    const ADMOB_CONFIG = {
      isTesting: true,
      bannerId: 'ca-app-pub-3940256099942544/6300978111',
      interstitialId: 'ca-app-pub-3940256099942544/1033173712',
      cooldownMs: 90000
    };

    const APP_INFO = {
      privacyPolicyUrl: '',
      supportEmail: 'contato@seudominio.com'
    };

    (function verifyLocalCoverImage() {
      const testImg = new Image();
      testImg.onerror = () => {
        const cover = document.getElementById('coverScreen');
        if (cover) cover.classList.add('fallback-bg');
      };
      testImg.src = './assets/cover-bg.jpg';
    })();

    function openPrivacyPolicy() {
      document.getElementById('privacyEmail').textContent = APP_INFO.supportEmail;
      const extLink = document.getElementById('externalPrivacyLink');
      if (APP_INFO.privacyPolicyUrl) {
        extLink.href = APP_INFO.privacyPolicyUrl;
        extLink.style.display = 'inline';
      } else {
        extLink.style.display = 'none';
      }
      document.getElementById('privacyModal').style.display = 'flex';
    }

    function closePrivacyPolicy() {
      document.getElementById('privacyModal').style.display = 'none';
    }

    let admobPlugin = null;
    let interstitialReady = false;
    let lastInterstitialTime = 0;

    async function prepareInterstitial() {
      if (!admobPlugin) return;
      try {
        await admobPlugin.prepareInterstitial({
          adId: ADMOB_CONFIG.interstitialId,
          isTesting: ADMOB_CONFIG.isTesting
        });
        interstitialReady = true;
      } catch (err) {
        interstitialReady = false;
      }
    }

    async function showInterstitialAd() {
      if (!admobPlugin || !interstitialReady) return;
      const now = Date.now();
      if (now - lastInterstitialTime < ADMOB_CONFIG.cooldownMs) return;

      try {
        await admobPlugin.showInterstitial();
        lastInterstitialTime = Date.now();
        interstitialReady = false;
        prepareInterstitial();
      } catch (err) {
        interstitialReady = false;
      }
    }

    async function initAdMob() {
      try {
        if (window.Capacitor && window.Capacitor.Plugins && window.Capacitor.Plugins.AdMob) {
          const { AdMob, BannerAdPosition, BannerAdSize } = window.Capacitor.Plugins;
          admobPlugin = AdMob;

          await AdMob.initialize({ requestTrackingAuthorization: true });

          await AdMob.showBanner({
            adId: ADMOB_CONFIG.bannerId,
            position: BannerAdPosition.BOTTOM_CENTER,
            size: BannerAdSize.BANNER,
            margin: 0,
            isTesting: ADMOB_CONFIG.isTesting
          });

          await prepareInterstitial();
        }
      } catch (e) {
        console.log("AdMob indisponível neste ambiente.", e);
      }
    }

    let audioCtx = null;
    const deckNodes = { A: {}, B: {} };
    const eqNodes = { A: {}, B: {} };
    const fxState = {
      A: { reverb: false, delay: false, reverbWet: null, delayWet: null, delayFeedback: null },
      B: { reverb: false, delay: false, reverbWet: null, delayWet: null, delayFeedback: null }
    };
    let cuePoints = { A: 0, B: 0 };
    let loopIntervals = { A: null, B: null };

    let wavesurferA = null;
    let wavesurferB = null;

    function loadScriptWithFallback(srcList) {
      return new Promise((resolve) => {
        let index = 0;
        function tryNext() {
          if (index >= srcList.length) {
            resolve(false);
            return;
          }
          const script = document.createElement('script');
          script.src = srcList[index++];
          script.onload = () => resolve(Boolean(window.WaveSurfer));
          script.onerror = tryNext;
          document.head.appendChild(script);
        }
        tryNext();
      });
    }

    function initWaveSurferDecks() {
      if (!window.WaveSurfer) return false;
      if (!wavesurferA) {
        wavesurferA = window.WaveSurfer.create({
          container: '#waveA',
          waveColor: '#0f0',
          progressColor: '#0ff',
          height: 80
        });
      }
      if (!wavesurferB) {
        wavesurferB = window.WaveSurfer.create({
          container: '#waveB',
          waveColor: '#f00',
          progressColor: '#ff0',
          height: 80
        });
      }
      return true;
    }

    document.addEventListener("DOMContentLoaded", async () => {
      await initAdMob();
      const loaded = await loadScriptWithFallback([
        './assets/wavesurfer.min.js',
        'https://unpkg.com/wavesurfer.js@7'
      ]);
      if (loaded) {
        initWaveSurferDecks();
      } else {
        console.warn("WaveSurfer não pôde ser carregado (verifique ./assets/wavesurfer.min.js ou conexão).");
      }
    });

    function launchApp(action) {
      initWaveSurferDecks();
      document.getElementById('coverScreen').style.opacity = '0';
      setTimeout(() => {
        document.getElementById('coverScreen').style.display = 'none';
        document.getElementById('appContent').style.display = 'block';
        initAudioContext();
        syncFxButtons();

        if (action === 'record') {
          setTimeout(startRecording, 500);
        }
      }, 500);
    }

    function initAudioContext() {
      initWaveSurferDecks();
      if (!audioCtx) {
        audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        initDeck("A", wavesurferA, "timeA");
        initDeck("B", wavesurferB, "timeB");
      } else if (audioCtx.state === 'suspended') {
        audioCtx.resume();
      }
    }

    function createImpulseBuffer(duration = 1.8, decay = 2.5) {
      const length = Math.floor(audioCtx.sampleRate * duration);
      const impulse = audioCtx.createBuffer(2, length, audioCtx.sampleRate);
      for (let ch = 0; ch < 2; ch++) {
        const channelData = impulse.getChannelData(ch);
        for (let i = 0; i < length; i++) {
          channelData[i] = (Math.random() * 2 - 1) * Math.pow(1 - i / length, decay);
        }
      }
      return impulse;
    }

    function initDeck(deck, wavesurfer, timeId) {
      deckNodes[deck].gain = audioCtx.createGain();
      deckNodes[deck].analyser = audioCtx.createAnalyser();
      deckNodes[deck].analyser.fftSize = 256;

      eqNodes[deck].low = audioCtx.createBiquadFilter();
      eqNodes[deck].low.type = "lowshelf";
      eqNodes[deck].low.frequency.value = 200;

      eqNodes[deck].mid = audioCtx.createBiquadFilter();
      eqNodes[deck].mid.type = "peaking";
      eqNodes[deck].mid.frequency.value = 1000;

      eqNodes[deck].high = audioCtx.createBiquadFilter();
      eqNodes[deck].high.type = "highshelf";
      eqNodes[deck].high.frequency.value = 5000;

      const convolver = audioCtx.createConvolver();
      convolver.buffer = createImpulseBuffer();
      const reverbWet = audioCtx.createGain();
      reverbWet.gain.value = 0;
      deckNodes[deck].gain.connect(convolver);
      convolver.connect(reverbWet);
      reverbWet.connect(deckNodes[deck].analyser);

      const delayNode = audioCtx.createDelay(5.0);
      delayNode.delayTime.value = 0.35;
      const delayFeedback = audioCtx.createGain();
      delayFeedback.gain.value = 0.35;
      const delayWet = audioCtx.createGain();
      delayWet.gain.value = 0;
      deckNodes[deck].gain.connect(delayNode);
      delayNode.connect(delayFeedback);
      delayFeedback.connect(delayNode);
      delayNode.connect(delayWet);
      delayWet.connect(deckNodes[deck].analyser);

      fxState[deck].reverbWet = reverbWet;
      fxState[deck].delayWet = delayWet;
      fxState[deck].delayFeedback = delayFeedback;

      if (wavesurfer && typeof wavesurfer.getMediaElement === 'function') {
        const mediaElement = wavesurfer.getMediaElement();
        if (mediaElement) {
          const src = audioCtx.createMediaElementSource(mediaElement);
          src.connect(eqNodes[deck].low);
          eqNodes[deck].low.connect(eqNodes[deck].mid);
          eqNodes[deck].mid.connect(eqNodes[deck].high);
          eqNodes[deck].high.connect(deckNodes[deck].gain);
          deckNodes[deck].gain.connect(deckNodes[deck].analyser);
          deckNodes[deck].analyser.connect(audioCtx.destination);
        }

        wavesurfer.on('timeupdate', () => updateTime(deck, timeId));
        wavesurfer.on('ready', () => updateTime(deck, timeId));
      }

      drawSpectrum(deckNodes[deck].analyser, "spectrum" + deck);
    }

    function formatTime(seconds) {
      if (isNaN(seconds)) return "00:00";
      const minutes = Math.floor(seconds / 60);
      const secs = Math.floor(seconds % 60);
      return `${minutes.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
    }

    function updateTime(deck, timeId) {
      const ws = deck === "A" ? wavesurferA : wavesurferB;
      if (!ws) return;
      const current = ws.getCurrentTime() || 0;
      const duration = ws.getDuration() || 0;
      document.getElementById(timeId).textContent = `${formatTime(current)} / ${formatTime(duration)}`;
    }

    function loadTrack(input, deck) {
      initAudioContext();
      const file = input.files[0];
      if (!file) return;
      const ws = deck === "A" ? wavesurferA : wavesurferB;
      if (!ws) {
        alert("WaveSurfer ainda não carregou.");
        return;
      }
      const url = URL.createObjectURL(file);
      ws.load(url);
    }

    function play(deck) {
      initAudioContext();
      const ws = deck === "A" ? wavesurferA : wavesurferB;
      if (ws) ws.play();
    }

    function pause(deck) {
      const ws = deck === "A" ? wavesurferA : wavesurferB;
      if (ws) ws.pause();
    }

    function setCue(deck) {
      const ws = deck === "A" ? wavesurferA : wavesurferB;
      if (ws) cuePoints[deck] = ws.getCurrentTime();
    }

    function goToCue(deck) {
      const ws = deck === "A" ? wavesurferA : wavesurferB;
      if (ws) ws.setTime(cuePoints[deck]);
    }

    function startLoop(deck) {
      const ws = deck === "A" ? wavesurferA : wavesurferB;
      if (!ws) return;
      const startTime = ws.getCurrentTime();
      const endTime = startTime + 4;

      stopLoop(deck);

      loopIntervals[deck] = setInterval(() => {
        if (ws.getCurrentTime() >= endTime || ws.getCurrentTime() < startTime) {
          ws.setTime(startTime);
        }
      }, 100);
    }

    function stopLoop(deck) {
      if (loopIntervals[deck]) {
        clearInterval(loopIntervals[deck]);
        loopIntervals[deck] = null;
      }
    }

    function setVolume(value, deck) {
      if (deckNodes[deck].gain) {
        deckNodes[deck].gain.gain.value = parseFloat(value);
      }
    }

    function setPitch(value, deck) {
      const ws = deck === "A" ? wavesurferA : wavesurferB;
      if (ws) ws.setPlaybackRate(parseFloat(value));
    }

    function setEQ(deck, band, value) {
      if (eqNodes[deck][band]) {
        eqNodes[deck][band].gain.value = parseFloat(value);
      }
    }

    function crossfade(value) {
      if (!audioCtx) return;
      const curve = document.getElementById("curve").value;
      const val = parseFloat(value);
      let gA, gB;

      if (curve === "linear") { gA = 1 - val; gB = val; }
      else if (curve === "exponential") { gA = Math.pow(1 - val, 2); gB = Math.pow(val, 2); }
      else if (curve === "log") { gA = Math.log10((1 - val) * 9 + 1); gB = Math.log10(val * 9 + 1); }
      else { gA = 1 / (1 + Math.exp((val - 0.5) * 10)); gB = 1 - gA; }

      if (deckNodes.A.gain) deckNodes.A.gain.gain.setTargetAtTime(gA, audioCtx.currentTime, 0.01);
      if (deckNodes.B.gain) deckNodes.B.gain.gain.setTargetAtTime(gB, audioCtx.currentTime, 0.01);
    }

    function drawSpectrum(analyser, canvasId) {
      const canvas = document.getElementById(canvasId);
      const ctx = canvas.getContext("2d");

      function render() {
        requestAnimationFrame(render);

        if (canvas.width !== canvas.clientWidth || canvas.height !== canvas.clientHeight) {
          canvas.width = canvas.clientWidth;
          canvas.height = canvas.clientHeight;
        }

        const bufferLength = analyser.frequencyBinCount;
        const dataArray = new Uint8Array(bufferLength);
        analyser.getByteFrequencyData(dataArray);

        ctx.fillStyle = "#111";
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        const barWidth = (canvas.width / bufferLength) * 2.5;
        let x = 0;

        for (let i = 0; i < bufferLength; i++) {
          const barHeight = (dataArray[i] / 255) * canvas.height;
          ctx.fillStyle = `rgb(${dataArray[i]}, 255, 255)`;
          ctx.fillRect(x, canvas.height - barHeight, barWidth, barHeight);
          x += barWidth + 1;
        }
      }
      render();
    }

    function getFXDeck() { return document.getElementById("fxDeck").value; }

    function syncFxButtons() {
      const deck = getFXDeck();
      const btnReverb = document.getElementById("btnReverb");
      const btnDelay = document.getElementById("btnDelay");

      btnReverb.textContent = `🌫️ Reverb: ${fxState[deck].reverb ? "ON" : "OFF"}`;
      btnReverb.classList.toggle("active-fx", fxState[deck].reverb);

      btnDelay.textContent = `⏱️ Delay: ${fxState[deck].delay ? "ON" : "OFF"}`;
      btnDelay.classList.toggle("active-fx", fxState[deck].delay);
    }

    function sweepFilter(deck) {
      initAudioContext();
      if (!audioCtx || !eqNodes[deck].mid) return;
      const midFilter = eqNodes[deck].mid;
      const now = audioCtx.currentTime;
      const previousGain = midFilter.gain.value;

      midFilter.gain.cancelScheduledValues(now);
      midFilter.frequency.cancelScheduledValues(now);
      midFilter.gain.setValueAtTime(10, now);
      midFilter.frequency.setValueAtTime(300, now);
      midFilter.frequency.exponentialRampToValueAtTime(4500, now + 1.5);
      midFilter.frequency.exponentialRampToValueAtTime(1000, now + 2.5);
      midFilter.gain.setTargetAtTime(previousGain, now + 2.5, 0.05);
    }

    function toggleReverb(deck, btn) {
      initAudioContext();
      const state = fxState[deck];
      state.reverb = !state.reverb;
      if (state.reverbWet) {
        state.reverbWet.gain.setTargetAtTime(state.reverb ? 0.55 : 0, audioCtx.currentTime, 0.03);
      }
      btn.textContent = `🌫️ Reverb: ${state.reverb ? "ON" : "OFF"}`;
      btn.classList.toggle("active-fx", state.reverb);
    }

    function toggleDelay(deck, btn) {
      initAudioContext();
      const state = fxState[deck];
      state.delay = !state.delay;
      if (state.delayWet) {
        state.delayWet.gain.setTargetAtTime(state.delay ? 0.5 : 0, audioCtx.currentTime, 0.03);
      }
      btn.textContent = `⏱️ Delay: ${state.delay ? "ON" : "OFF"}`;
      btn.classList.toggle("active-fx", state.delay);
    }

    function blobToBase64(blob) {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onloadend = () => {
          const result = String(reader.result || '');
          const base64 = result.includes(',') ? result.split(',')[1] : result;
          resolve(base64);
        };
        reader.onerror = reject;
        reader.readAsDataURL(blob);
      });
    }

    async function saveRecordingNativeOrWeb(blob) {
      const fileName = `sonic-fusion-${Date.now()}.webm`;
      const link = document.getElementById("downloadLink");

      const hasCapacitorPlugins =
        window.Capacitor &&
        window.Capacitor.isNativePlatform &&
        window.Capacitor.isNativePlatform() &&
        window.Capacitor.Plugins &&
        window.Capacitor.Plugins.Filesystem;

      if (hasCapacitorPlugins) {
        try {
          const { Filesystem, Directory } = window.Capacitor.Plugins;
          const base64Data = await blobToBase64(blob);

          const savedFile = await Filesystem.writeFile({
            path: fileName,
            data: base64Data,
            directory: Directory.Cache
          });

          if (link) {
            link.removeAttribute("href");
            link.style.display = "block";
            link.textContent = `✅ Gravação salva (${fileName}) — Toque para compartilhar/salvar`;
            link.onclick = async (ev) => {
              ev.preventDefault();
              if (window.Capacitor.Plugins.Share && savedFile.uri) {
                await window.Capacitor.Plugins.Share.share({
                  title: "Gravação Sonic Fusion",
                  text: "Minha mixagem gravada no Sonic Fusion",
                  url: savedFile.uri,
                  dialogTitle: "Salvar ou compartilhar gravação"
                });
              }
            };
          }

          if (window.Capacitor.Plugins.Share && savedFile.uri) {
            await window.Capacitor.Plugins.Share.share({
              title: "Gravação Sonic Fusion",
              text: "Minha mixagem gravada no Sonic Fusion",
              url: savedFile.uri,
              dialogTitle: "Salvar ou compartilhar gravação"
            });
          }
          return;
        } catch (err) {
          console.error("Erro ao salvar nativamente via Capacitor:", err);
        }
      }

      const url = URL.createObjectURL(blob);
      link.onclick = null;
      link.href = url;
      link.download = fileName;
      link.style.display = "block";
      link.textContent = "⬇️ Baixar Mixagem Gravada";
    }

    let mediaRecorder, chunks = [];
    function startRecording() {
      initAudioContext();
      if (!audioCtx) return;
      const dest = audioCtx.createMediaStreamDestination();
      if (deckNodes.A.analyser) deckNodes.A.analyser.connect(dest);
      if (deckNodes.B.analyser) deckNodes.B.analyser.connect(dest);

      chunks = [];
      mediaRecorder = new MediaRecorder(dest.stream);
      mediaRecorder.ondataavailable = e => chunks.push(e.data);
      mediaRecorder.onstop = async () => {
        const blob = new Blob(chunks, { type: 'audio/webm' });
        await saveRecordingNativeOrWeb(blob);
        await showInterstitialAd();
      };
      mediaRecorder.start();
    }

    function stopRecording() {
      if (mediaRecorder && mediaRecorder.state !== "inactive") {
        mediaRecorder.stop();
      }
    }
  </script>
